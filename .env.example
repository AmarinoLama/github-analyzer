# ---------------------------------------------------------------
# AI CODE ANALYZER - Configuración
# Copia este archivo a `.env` y ajusta los valores.
# ---------------------------------------------------------------

# --- OpenCode Server -------------------------------------------------
# URL base del servidor que levantas con `opencode serve`
OPENCODE_BASE_URL=http://127.0.0.1:4096

# Modelo concreto (formato provider/model). Si se deja vacío, la app
# descubre el modelo por defecto consultando /config/providers.
OPENCODE_PROVIDER_ID=
OPENCODE_MODEL_ID=

# Agente de OpenCode (opcional): build, plan, general, explore...
OPENCODE_AGENT=

# Autenticación básica opcional (si `opencode serve` se lanzó con
# OPENCODE_SERVER_PASSWORD / OPENCODE_SERVER_USERNAME).
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=

# --- Embeddings ------------------------------------------------------
# auto        -> intenta HuggingFace y, si no está disponible, usa hash
# huggingface -> sentence-transformers (embeddings semánticos reales)
# hash        -> fallback determinista en Python puro (sin descargas)
EMBEDDINGS_PROVIDER=auto
HF_MODEL_NAME=all-MiniLM-L6-v2

# --- Indexación ------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=6
MAX_FILE_KB=512

# --- Semgrep ---------------------------------------------------------
# Reglas a usar: "auto" (autodetección) o una ruta/paquete de reglas.
SEMGREP_CONFIG=auto
